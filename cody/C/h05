	    karta = karty[rand() % 13];
	    printf("%c, ", karta);
	    kombinace[i + 2] = karta;
	}
	printf("\n");

	for (int i = 0; i < length; i++) {
	    printf("%c, ", kombinace[i]);
	}

	int dvojice;
	int res = 0;

	for (int i = 0; i < length; i++) {
	    dvojice = kombinace[i];
	    for (int j = 0; j < length; j++) {
	        if (dvojice == kombinace[j]) {
	            res++;
	            if (res > 1) break;
	        }
	    }
	}
	printf("\n%d", res);

