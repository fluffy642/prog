<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="Body" Background="white">
        <Button Content="Click me!" HorizontalAlignment="Center" Margin="0,65,0,0" VerticalAlignment="Top" Height="50" Width="312" Click="Button_Click"/>
        <TextBlock x:Name="TextBlock" HorizontalAlignment="Center" Height="15" Margin="0,310,0,0" TextWrapping="Wrap" Text="..." VerticalAlignment="Top" Width="312" RenderTransformOrigin="1.343,3.443"/>
        <TextBox x:Name="Den" HorizontalAlignment="Center" Height="18" Margin="0,135,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="312" TextChanged="TextBox_TextChanged" Cursor="IBeam"/>
        <TextBlock HorizontalAlignment="Left" Margin="148,136,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="91"><Run Text="Zadej den"/><LineBreak/><Run/></TextBlock>
        <TextBlock x:Name="SecretText" HorizontalAlignment="Center" Height="64" Margin="0,278,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="474" FontSize="48"/>
        <TextBlock x:Name="GTA" HorizontalAlignment="Center" Height="16" Margin="0,265,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="312"><Run Text="GTA VI ..."/><LineBreak/><Run/></TextBlock>
        <TextBox x:Name="Mesic" HorizontalAlignment="Center" Height="18" Margin="0,166,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="312" TextChanged="TextBox_TextChanged" Cursor="IBeam"/>
        <TextBlock HorizontalAlignment="Left" Margin="148,167,0,0" TextWrapping="Wrap" Text="Zadej mesic" VerticalAlignment="Top" Width="91"/>
        <TextBox x:Name="Rok" HorizontalAlignment="Center" Height="18" Margin="0,200,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="312" TextChanged="TextBox_TextChanged" Cursor="IBeam"/>
        <TextBlock HorizontalAlignment="Left" Margin="148,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="91"><Run Text="Zadej rok"/><LineBreak/><Run/></TextBlock>

    </Grid>
</Window>
