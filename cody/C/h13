int delkaPlaylistu (int arr[], int length) {
    int res = 0;
    for (int i = 0; i < length; i++) {
        res += arr[i];
    }
    return res;
}

int pripitky(int lidi) {
    int res = 0;
    for (int i = lidi; i >= 1; i--) {
        for (int j = 1; j < i; j++) {
            res += 1;
        }
    }
    return res;
}

int mocnina (int cislo, int mocnitel) {
    if (mocnitel == 1) {
        return cislo;
    }
    return cislo * mocnina(cislo, --mocnitel);
    
}

